# user end points ==========================

#api call for registering user
###
POST http://127.0.0.1:8000/tracker/admin-register/
Content-Type: application/json

{
    "username":"user2",
    "email":"user2@gmail.com",
    "password":"user@123"
}


#api call for token generation
###
POST http://127.0.0.1:8000/tracker/token/
Content-Type: application/json

{
    "username":"user2",
    "password":"user@123"
}



#api call for getting user details
###
GET http://127.0.0.1:8000/tracker/getme/
Accept: application/json
Authorization: Basic user1:user@123


# Foodlog endpoints ============================

#api call for listing foodlogs
###
GET http://127.0.0.1:8000/tracker/foodlogs/
Accept: application/json
# Authorization: Basic user1:user@123
Authorization: Token 4cc6c04de7eef33756b4748c2aa4108741da83cb


#api call for posting foodlogs
###
POST http://127.0.0.1:8000/tracker/foodlogs/
Content-Type: application/json
Authorization: Token 4cc6c04de7eef33756b4748c2aa4108741da83cb

{
    "title": "Idli",
    "calorie": 180,
    "meal_type": "Breakfast",
    "serving_size": "150"
}

# api call for retriving specific foodlogs
###
GET http://127.0.0.1:8000/tracker/foodlogs/5/
Accept: application/json
Authorization: Token 4cc6c04de7eef33756b4748c2aa4108741da83cb

# api call for upadating foodlogs
###
PUT http://127.0.0.1:8000/tracker/foodlogs/1/
Content-Type: application/json
Authorization: Token 4cc6c04de7eef33756b4748c2aa4108741da83cb

{
    "title": "Chicken Fried Rice",
    "calorie": 450,
    "meal_type": "Lunch",
    "serving_size": "300"
}

# api call for deleting foodlog
###
DELETE http://127.0.0.1:8000/tracker/foodlogs/4/
Accept: application/json
Authorization: Token 4cc6c04de7eef33756b4748c2aa4108741da83cb


# api call for foodlog summary
###
GET http://127.0.0.1:8000/tracker/foodlogs/summary/
Accept: application/json
Authorization: Token 4cc6c04de7eef33756b4748c2aa4108741da83cb

# api call for summary
###
GET http://127.0.0.1:8000/tracker/dietplan/
Accept: application/json
Authorization: Token 4cc6c04de7eef33756b4748c2aa4108741da83cb